# Beyond Compare 3 差分統計一括ツール
# Windows PowerShell 5.1 用
# UTF-8 BOM で保存してください。

# ===== 1. 設定 =====
$LeftRoot  = 'D:\LEFT_FOLDER'
$RightRoot = 'D:\RIGHT_FOLDER'
$BCompare  = 'D:\TOOL\Beyond Compare 3\BCompare.exe'
$WorkDir   = 'D:\TOOL\Beyond Compare 3\Reports'

# 比較しないフォルダー
$ExcludeDirs = @('node_modules', '.git')

$ErrorActionPreference = 'Stop'

$ScriptFile  = Join-Path $WorkDir 'compare_generated.txt'
$SummaryFile = Join-Path $WorkDir 'summary.csv'
$ErrorsFile  = Join-Path $WorkDir 'compare_errors.csv'
$MissingFile = Join-Path $WorkDir 'missing_files.csv'
$ReportDir   = Join-Path $WorkDir 'detail_reports'

# ===== 2. 共通関数 =====

# Beyond Compare用のパスを引用符で囲む
function Quote-BC([string]$Value) {
    if ($Value.Contains('"')) {
        throw "パスに引用符があります: $Value"
    }
    return '"' + $Value + '"'
}

# サブフォルダーを再帰的に取得する
# node_modules、.gitには入らない
# 読み取りエラーは無視せず処理を中断する
function Get-FileMap([string]$Root) {
    $map = @{}
    $stack = New-Object 'System.Collections.Stack'
    $stack.Push($Root)

    while ($stack.Count -gt 0) {
        $folder = [string]$stack.Pop()

        $items = @(
            Get-ChildItem -LiteralPath $folder -Force `
                -ErrorAction Stop
        )

        foreach ($item in $items) {
            if ($item.PSIsContainer) {
                if ($item.Attributes -band `
                    [IO.FileAttributes]::ReparsePoint) {
                    continue
                }

                if ($ExcludeDirs -notcontains $item.Name) {
                    $stack.Push($item.FullName)
                }
            }
            else {
                $rel = $item.FullName.Substring(
                    $Root.Length
                ).TrimStart('\')

                $map[$rel] = $item.FullName
            }
        }
    }

    return $map
}

# CSVを出力する
function Save-Csv($Rows, $Path, $Header) {
    if (@($Rows).Count -gt 0) {
        $Rows | Export-Csv -LiteralPath $Path `
            -NoTypeInformation -Encoding UTF8
    }
    else {
        $Header | Set-Content -LiteralPath $Path `
            -Encoding UTF8
    }
}

# ===== 3. 初期処理 =====

$LeftRoot = (Resolve-Path -LiteralPath $LeftRoot).Path.TrimEnd('\')
$RightRoot = (Resolve-Path -LiteralPath $RightRoot).Path.TrimEnd('\')

if (-not (Test-Path -LiteralPath $BCompare -PathType Leaf)) {
    throw "Beyond Compareが見つかりません: $BCompare"
}

if (-not (Test-Path -LiteralPath $WorkDir -PathType Container)) {
    throw "出力フォルダーがありません: $WorkDir"
}

# 前回の結果が混入しないように削除する
if (Test-Path -LiteralPath $ReportDir) {
    Remove-Item -LiteralPath $ReportDir -Recurse -Force
}

New-Item -ItemType Directory -Path $ReportDir | Out-Null

foreach ($path in @(
    $ScriptFile, $SummaryFile, $ErrorsFile, $MissingFile
)) {
    if (Test-Path -LiteralPath $path) {
        Remove-Item -LiteralPath $path -Force
    }
}

# ===== 4. ファイル一覧取得 =====

Write-Host 'ファイル一覧を取得しています...'

$leftMap = Get-FileMap $LeftRoot
$rightMap = Get-FileMap $RightRoot

$paths = @(
    @($leftMap.Keys) + @($rightMap.Keys) |
        Sort-Object -Unique
)

$commands = New-Object 'System.Collections.Generic.List[string]'
$commands.Add('criteria rules-based')

$manifest = New-Object 'System.Collections.Generic.List[object]'
$missing = New-Object 'System.Collections.Generic.List[object]'

$index = 0

# ===== 5. 差分候補の抽出 =====

foreach ($rel in $paths) {
    $hasL = $leftMap.ContainsKey($rel)
    $hasR = $rightMap.ContainsKey($rel)

    # 片側のみに存在するファイル
    if (-not ($hasL -and $hasR)) {
        $status = if ($hasL) {
            '左側のみ'
        }
        else {
            '右側のみ'
        }

        $missing.Add([pscustomobject]@{
            File = $rel
            Status = $status
        })
        continue
    }

    $lp = $leftMap[$rel]
    $rp = $rightMap[$rel]

    # SHA256で内容が完全一致するファイルを除外
    $hashL = (Get-FileHash -LiteralPath $lp -Algorithm SHA256).Hash
    $hashR = (Get-FileHash -LiteralPath $rp -Algorithm SHA256).Hash

    if ($hashL -eq $hashR) {
        continue
    }

    $index++

    # ファイルごとに別のCSVを出力する
    $reportName = 'report_{0:D6}.csv' -f $index
    $reportPath = Join-Path $ReportDir $reportName

    # 元の成功したfile-report形式を使用する
    # appendは使用しない
    $cmd = 'file-report layout:statistics options:display-all'
    $cmd += ' output-to:' + (Quote-BC $reportPath)
    $cmd += ' ' + (Quote-BC $lp)
    $cmd += ' ' + (Quote-BC $rp)

    $commands.Add($cmd)

    $manifest.Add([pscustomobject]@{
        File = $rel
        Report = $reportPath
    })
}

# ===== 6. Beyond Compare実行 =====

Save-Csv $missing.ToArray() $MissingFile '"File","Status"'

# Beyond Compare 3用スクリプトを出力
# 日本語パスはWindowsのANSI設定に依存する
$commands | Set-Content -LiteralPath $ScriptFile `
    -Encoding Default

Write-Host "差分候補: $index 件"
Write-Host "片側のみ: $($missing.Count) 件"

if ($index -gt 0) {
    # 一度だけBeyond Compareを起動する
    & $BCompare "@$ScriptFile"
}

# ===== 7. 個別CSVの集約 =====

$summary = New-Object 'System.Collections.Generic.List[object]'
$errors = New-Object 'System.Collections.Generic.List[object]'
$expectedColumns = $null

foreach ($item in $manifest) {

    # レポート未作成の場合
    if (-not (Test-Path -LiteralPath $item.Report -PathType Leaf)) {
        $errors.Add([pscustomobject]@{
            File = $item.File
            Reason = 'レポート未作成'
        })
        continue
    }

    try {
        $rows = @(Import-Csv -LiteralPath $item.Report -ErrorAction Stop)

        if ($rows.Count -eq 0) {
            throw 'レポートが空です'
        }

        # CSV列構成を確認する
        $columns = @($rows[0].PSObject.Properties.Name)
        $columnKey = $columns -join '|'

        if ($null -eq $expectedColumns) {
            $expectedColumns = $columnKey
        }

        if ($columnKey -ne $expectedColumns) {
            throw 'CSV列構成が異なります'
        }

        foreach ($row in $rows) {
            $record = [ordered]@{
                File = $item.File
            }

            foreach ($column in $columns) {
                $record[$column] = $row.$column
            }

            $summary.Add([pscustomobject]$record)
        }
    }
    catch {
        $errors.Add([pscustomobject]@{
            File = $item.File
            Reason = $_.Exception.Message
        })
    }
}

# ===== 8. 最終結果出力 =====

Save-Csv $summary.ToArray() $SummaryFile '"File"'
Save-Csv $errors.ToArray() $ErrorsFile '"File","Reason"'

Write-Host ''
Write-Host '===== 処理結果 ====='
Write-Host "集計行数: $($summary.Count)"
Write-Host "エラー件数: $($errors.Count)"
Write-Host "集計結果: $SummaryFile"
Write-Host "エラー一覧: $ErrorsFile"
Write-Host "片側のみ: $MissingFile"
Write-Host '処理終了'